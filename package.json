{
  "name": "aethex-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preinstall": "npm config set legacy-peer-deps true",
    "dev": "node -r ./patch-fs.js node_modules/next/dist/bin/next dev",
    "build": "node -r ./patch-fs.js node_modules/next/dist/bin/next build && next-on-pages",
    "preview": "node -r ./patch-fs.js node_modules/next/dist/bin/next build && next-on-pages preview",
    "start": "next start",
    "pages:build": "node -r ./patch-fs.js node_modules/next/dist/bin/next build && next-on-pages"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/postcss": "^4.3.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.400.0",
    "next": "^15.5.19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.12.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10",
    "eslint": "^8",
    "postcss": "^8",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  }
}